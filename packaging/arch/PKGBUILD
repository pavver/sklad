# Maintainer: pavver <https://github.com/pavver>
# Built by .github/workflows/release.yml for the sklad pacman repository.

pkgname=sklad
pkgver=0.4.0
pkgrel=1
pkgdesc='Catalogue of everything installed on Arch Linux, with safe removal'
arch=('x86_64')
url='https://github.com/pavver/sklad'
license=('MIT')
depends=(
  'gcc-libs'
  'glib2'
  'glibc'
  'hicolor-icon-theme'
  'libxkbcommon'
  'pacman'
  'polkit'
  'vulkan-icd-loader'
  'wayland'
  'xdg-utils'
)
makedepends=('cargo' 'git')
optdepends=(
  'flatpak: list and remove Flatpak applications'
  'steam: list, launch and remove Steam games'
  'libxcursor: run under X11'
  'libxrandr: run under X11'
  'libxi: run under X11'
)
# Link-time optimisation of C turns the bundled SQLite into bitcode the Rust linker cannot use.
options=('!lto' '!debug')
source=("$pkgname::git+https://github.com/pavver/sklad.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  # The window tests need a GPU, so the package checks the library alone.
  cargo test --frozen --release --lib
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/sklad "$pkgdir/usr/bin/sklad"
  install -Dm644 packaging/sklad.desktop "$pkgdir/usr/share/applications/sklad.desktop"
  install -Dm644 assets/sklad.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/sklad.svg"
  install -Dm644 packaging/io.github.pavver.sklad.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.pavver.sklad.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE.md "$pkgdir/usr/share/licenses/$pkgname/NOTICE.md"
}
